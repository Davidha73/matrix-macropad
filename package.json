{
  "name": "matrix-macropad",
  "version": "1.0.2",
  "description": "Matrix Macropad Desktop Bridge & Configurator",
  "main": "main.js",
  "scripts": {
    "start": "node run.js",
    "tauri": "tauri",
    "sync:ui": "node sync-ui.js",
    "tauri:dev": "node run-tauri.js",
    "tauri:build": "tauri build",
    "flash": "bash flash.sh",
    "flash:win": "flash.bat",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder -mw"
  },
  "build": {
    "appId": "com.matrix.macropad",
    "productName": "Matrix Macropad",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "**/*",
      "!src-tauri/**",
      "!dist/**",
      "!node_modules_win/**",
      "!libraries/**",
      "!firmware/**",
      "!flash.sh",
      "!flash.bat",
      "!start_win.bat",
      "!start_mac.command",
      "!start.vbs",
      "!**/*.af",
      "!**/._*"
    ],
    "afterPack": "./after-pack.js",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/matrix-icon-256.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "Davidha73",
      "repo": "matrix-macropad"
    }
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.1",
    "electron-updater": "^6.8.9",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2"
  }
}
