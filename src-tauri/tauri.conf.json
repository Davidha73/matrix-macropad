{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Matrix Macropad",
  "version": "1.0.1",
  "identifier": "com.matrix.macropad",
  "build": {
    "beforeDevCommand": "npm run sync:ui",
    "beforeBuildCommand": "npm run sync:ui",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Matrix Macropad",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 750,
        "decorations": true,
        "resizable": true,
        "center": true,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/matrix-icon-256.ico",
      "../assets/app-icon.png"
    ]
  }
}
